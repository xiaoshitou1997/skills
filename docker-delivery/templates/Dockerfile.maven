# syntax=docker/dockerfile:1.7
ARG BUILD_IMAGE=maven:3.9-eclipse-temurin-17
ARG RUNTIME_IMAGE=eclipse-temurin:17-jre
FROM ${BUILD_IMAGE} AS builder
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.m2 mvn -B -ntp verify
RUN set -eu; mkdir -p /out; \
    find target -maxdepth 1 -type f -name '*.jar' \
      ! -name '*-sources.jar' ! -name '*-javadoc.jar' ! -name 'original-*.jar' > /tmp/skills-jars; \
    test "$(wc -l < /tmp/skills-jars)" -eq 1; \
    cp "$(cat /tmp/skills-jars)" /out/app.jar; \
    test -s /out/app.jar
FROM ${RUNTIME_IMAGE}
WORKDIR /app
COPY --from=builder /out/app.jar /app/app.jar
EXPOSE 8080
USER 10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
