# syntax=docker/dockerfile:1.7
# Gradle daemon 快速路径的运行时打包:构建由 gradle-daemon.sh 在常驻容器内完成,
# 产物按 templates/Dockerfile.gradle 相同规则选定唯一 boot jar 后复制为 out/app.jar。
ARG RUNTIME_IMAGE=eclipse-temurin:17-jre
FROM ${RUNTIME_IMAGE}
WORKDIR /app
COPY out/app.jar /app/app.jar
EXPOSE 8080
USER 10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
